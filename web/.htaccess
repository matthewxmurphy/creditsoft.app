Options -Indexes
DirectoryIndex index.html

RewriteEngine On

# Canonical CreditSoft license validation plus legacy compatibility aliases.
# Internal rewrites keep license keys out of redirect locations.
RewriteRule ^(?:license/validate(?:\.json)?|api/verify)/?$ /api/license-validate.php [END]

RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^(.+?)/?$ /$1/index.html [L]
