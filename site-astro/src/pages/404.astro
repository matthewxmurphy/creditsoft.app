---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Not Found | CreditSoft" description="The page you were looking for is not here.">
	<section class="page-hero">
		<div class="eyebrow">404</div>
		<h1>That page is not here.</h1>
		<p class="lede lede--narrow">
			The route may have moved while the new sales site is being rebuilt. Use the main navigation or head back
			to the homepage.
		</p>
		<a class="button button--primary" href="/">Back to CreditSoft</a>
	</section>
</Layout>
