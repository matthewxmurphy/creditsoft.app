---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

const title = "Terms of Service | CreditSoft";
const description = "CreditSoft Terms of Service for Metro2-first credit repair software, local-first office nodes, and customer accounts.";
---

<BaseLayout title={title} description={description} path="/terms">
  <SiteHeader />
  <main class="legal-page">
    <section class="legal-hero page-wrap">
      <p class="eyebrow">Legal</p>
      <h1>Terms of Service</h1>
      <p>The basic terms for using CreditSoft software, checkout, update, license, and public site services.</p>
    </section>

    <section class="legal-content page-wrap">
      <p class="last-updated">Last Updated: February 2026</p>

      <h2>1. Acceptance</h2>
      <p>By accessing CreditSoft or creating a checkout, customer dashboard, license, or office installation, you agree to these terms.</p>

      <h2>2. Service Description</h2>
      <p>CreditSoft provides Metro2-based credit repair workflow software, local-first office infrastructure, customer portal tooling, update delivery, and related support workflows.</p>

      <h2>3. Compliance</h2>
      <p>Users are responsible for complying with FCRA, FDCPA, CROA, state credit repair organization rules, privacy rules, and any laws that apply to their business.</p>

      <h2>4. Payments And Licensing</h2>
      <p>Checkout and renewal references help us match Zelle and Cash App payments to the correct customer account. License activation can require successful payment matching or manual approval.</p>

      <h2>5. Limitation Of Liability</h2>
      <p>CreditSoft provides tools and workflow support as is. We do not guarantee specific credit repair results, bureau outcomes, customer approvals, or legal outcomes.</p>

      <h2>6. Contact</h2>
      <p>Questions? Email <a href="mailto:hello@creditsoft.app">hello@creditsoft.app</a>.</p>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .legal-page { background: linear-gradient(180deg, rgba(8, 8, 10, 0.98), rgba(15, 23, 42, 0.98)); }
  .legal-hero { padding-top: 86px; padding-bottom: 34px; }
  .legal-hero h1 { margin: 0; font-size: clamp(3rem, 8vw, 6rem); letter-spacing: -0.07em; line-height: 0.95; }
  .legal-hero p:not(.eyebrow) { max-width: 720px; color: var(--muted); font-size: 1.12rem; line-height: 1.7; }
  .legal-content { max-width: 850px; padding-bottom: 82px; }
  .last-updated { color: var(--muted); margin-bottom: 32px; }
  .legal-content h2 { margin: 30px 0 10px; font-size: 1.45rem; }
  .legal-content p, .legal-content li { color: var(--muted); line-height: 1.75; }
  .legal-content a { color: #5bd695; font-weight: 800; }
</style>
