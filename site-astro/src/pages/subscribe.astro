---
import BaseLayout from "../layouts/BaseLayout.astro";

const target = "/checkout/?plan=professional&billing=monthly&payment=zelle";
---

<BaseLayout title="Start Checkout | CreditSoft" description="Start a CreditSoft checkout and create a payment reference before paying by Zelle or Cash App.">
  <meta http-equiv="refresh" content={`0; url=${target}`} slot="head" />
  <main class="redirect-page">
    <a href={target}>Continue to CreditSoft checkout</a>
  </main>
</BaseLayout>
