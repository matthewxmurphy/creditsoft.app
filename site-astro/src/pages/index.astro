---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { loadReviews, loadThemePage } from "../lib/preview-content";

const theme = await loadThemePage();
const reviews = (await loadReviews()).slice(0, 3);

const stars = (rating: number) => "★".repeat(Math.max(1, Math.min(5, rating)));
---

<BaseLayout
  title="CreditSoft | Metro2-first credit repair platform"
  description={theme.hero.summary}
>
  <SiteHeader topbarText={theme.topbarText} topbarEmail={theme.topbarEmail} />

  <main>
    <section class="section hero-poster">
      <div class="page-wrap hero-grid">
        <div class="hero-copy stagger">
          <span class="eyebrow">{theme.hero.eyebrow}</span>
          <h1 class="display">{theme.hero.title}</h1>
          <p class="lede">{theme.hero.summary}</p>
          <div class="button-row">
            <a class="button primary" href={theme.hero.primaryCta.href}>{theme.hero.primaryCta.label}</a>
            <a class="button secondary" href={theme.hero.secondaryCta.href}>{theme.hero.secondaryCta.label}</a>
          </div>
          <div class="metric-strip">
            {theme.hero.stats.map((stat) => (
              <span>{stat}</span>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="page-wrap section-shell">
        <SectionHeading
          eyebrow="Why CreditSoft"
          title="The site should look like the product behind it."
          text="The public site now carries the same product map as the office system: Metro2 review, CRM, portal, API bridge, and compliance lanes."
        />

        <div class="simple-grid two stagger">
          {theme.features.map((feature) => (
            <article class="info-card panel-soft">
              <h3>{feature.title}</h3>
              <p>{feature.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="page-wrap section-shell">
        <SectionHeading
          eyebrow="Proof"
          title="Real reviews can plug into the same visual system."
          text="Reviews, intake, product pages, and office proof belong in one Astro public site instead of being split between unrelated headers."
        />

        <div class="simple-grid three stagger">
          {reviews.map((review) => (
            <article class="info-card panel-soft">
              <span class="review-stars">{stars(review.rating)}</span>
              <h3>{review.fullName}</h3>
              <p>{review.quote}</p>
              <small>{review.company ?? "CreditSoft customer"}</small>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="page-wrap section-shell">
        <SectionHeading
          eyebrow="FAQ"
          title="Answers before the office ever has to ask."
          text="This keeps the common objections and setup questions in the site instead of buried in support replies."
        />

        <div class="simple-grid two">
          {theme.faqs.map((faq) => (
            <details class="faq-card panel-soft" open>
              <summary>{faq.question}</summary>
              <p>{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="page-wrap">
        <div class="cta-band panel">
          <span class="eyebrow">{theme.cta.eyebrow}</span>
          <h2>{theme.cta.title}</h2>
          <p>{theme.cta.text}</p>
          <div class="button-row">
            <a class="button primary" href={theme.cta.primaryCta.href}>{theme.cta.primaryCta.label}</a>
            <a class="button secondary" href={theme.cta.secondaryCta.href}>{theme.cta.secondaryCta.label}</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter summary={theme.footer.summary} contact={theme.footer.contact} />
</BaseLayout>

<style>
  .hero-poster {
    padding-top: 112px;
    padding-bottom: 78px;
  }

  .hero-poster .hero-grid {
    min-height: clamp(540px, 64vh, 820px);
    align-items: center;
  }

  .hero-poster .hero-copy {
    max-width: min(1180px, 100%);
  }

  .hero-poster .display {
    max-width: 1120px;
    font-size: clamp(4.2rem, 6.2vw, 7.4rem);
  }

  .hero-poster .lede {
    max-width: 940px;
    font-size: clamp(1.08rem, 1.25vw, 1.28rem);
  }

  .hero-poster .metric-strip {
    max-width: 1040px;
  }

  .review-stars,
  .info-card small {
    color: var(--muted);
  }

  .faq-card {
    padding: 24px 28px;
  }

  .faq-card summary {
    cursor: pointer;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .faq-card p {
    margin: 14px 0 0;
    color: var(--muted);
    line-height: 1.8;
  }

  @media (max-width: 900px) {
    .hero-poster {
      padding-top: 84px;
      padding-bottom: 48px;
    }

    .hero-poster .hero-grid {
      min-height: auto;
    }

    .hero-poster .display {
      font-size: clamp(3.2rem, 13vw, 5.1rem);
    }
  }
</style>
