---
import Layout from '../layouts/Layout.astro';
import { comparisonRows, emailProviders, planCards, proofPoints } from '../content/site';
import { loadInstallAds, loadPlans, loadReviews } from '../lib/site-data';

const planResult = await loadPlans(Astro.cookies);
const reviewResult = await loadReviews(Astro.cookies);
const adResult = await loadInstallAds(Astro.cookies);

const livePlans = planResult.data.length > 0 ? planResult.data : [];
const homePlans = livePlans.length > 0
	? livePlans.slice(0, 2).map((plan) => ({
			name: plan.name,
			price: `$${(plan.saleMonthlyPrice ?? plan.monthlyPrice).toFixed(2)} / mo`,
			listPrice: `$${plan.monthlyPrice.toFixed(2)} / mo`,
			badge: plan.badge ?? (plan.annualDiscountPercent ? `${plan.annualDiscountPercent}% annual savings` : 'Ready to launch'),
			copy: plan.description ?? 'CreditSoft plan',
			highlighted: plan.highlighted,
		}))
	: planCards;

const reviews = reviewResult.data.slice(0, 2);
const featuredAd = adResult.data[0] ?? null;
---

<Layout
	title="CreditSoft | Local-First Credit Operations"
	description="CreditSoft gives credit offices a local-first sales site, client portal, branded website, and operations workspace without the usual software sprawl."
>
	<section class="hero hero--home">
		<div class="hero__grid">
			<div class="hero__copy">
				<div class="eyebrow">CreditSoft App</div>
				<h1>Run the office, sell the service, and keep client operations off somebody else’s cloud.</h1>
				<p class="lede">
					Local-first credit operations with branded intake, portal, update, and website lanes that look
					like a real product instead of a stitched-together stack.
				</p>
				<div class="hero__actions">
					<a class="button button--primary" href="/subscribe">Start Office Fit Check</a>
					<a class="button button--secondary" href="/pricing">See Plans</a>
				</div>
			</div>

			<div class="hero__visual">
				<div class="poster">
					<div class="poster__eyebrow">What makes it different</div>
					<ul class="poster__list">
						<li>Local-first intranet operations</li>
						<li>Branded client website and portal lanes</li>
						<li>Migration, updates, and downloads under your brand</li>
						<li>Browser companion and admin rails without generic SaaS fluff</li>
					</ul>
					<div class="poster__meta">
						<span>Metro2-first</span>
						<span>PWA-ready</span>
						<span>Intranet based</span>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="section__intro">
			<div class="eyebrow">Why offices switch</div>
			<h2>Built like an operations product, not a pile of disconnected tools.</h2>
		</div>
		<div class="proof-grid">
			{proofPoints.map((item) => (
				<article class="proof-block">
					<h3>{item.title}</h3>
					<p>{item.copy}</p>
				</article>
			))}
		</div>
	</section>

	<section class="section section--contrast">
		<div class="section__intro">
			<div class="eyebrow">Us vs the usual stack</div>
			<h2>More of the work is already decided before your team has to touch it.</h2>
		</div>
		<div class="comparison-table">
			<div class="comparison-table__head">
				<span>Feature</span>
				<span>CreditSoft</span>
				<span>Typical stack</span>
			</div>
			{comparisonRows.map((row) => (
				<div class="comparison-table__row">
					<strong>{row.label}</strong>
					<span>{row.creditsoft}</span>
					<span>{row.typical}</span>
				</div>
			))}
		</div>
	</section>

	<section class="section">
		<div class="section__split">
			<div>
				<div class="eyebrow">Email delivery</div>
				<h2>Client notices can leave from the office system, not a maze of extra software.</h2>
				<p class="lede lede--narrow">
					CreditSoft supports SMTP-based sending lanes for Microsoft 365, Google Workspace, Amazon SES,
					SendGrid, Mailgun, Zoho Mail, Postmark, Brevo, SMTP.com, and custom office mail servers. Provider-login failures can be flagged for CRM review
					so staff can contact the customer before another report pull is attempted.
				</p>
			</div>
			<div class="provider-strip">
				{emailProviders.map((provider) => (
					<div class="provider-strip__item">
						<img src={provider.logo} alt={provider.label} loading="lazy" />
						<span>{provider.label}</span>
					</div>
				))}
			</div>
		</div>
	</section>

	<section class="section">
		<div class="section__split">
			<div>
				<div class="eyebrow">Site lanes</div>
				<h2>The sales site now gets its own structure.</h2>
				<p class="lede lede--narrow">
					Features, pricing, migration, outsourcing, videos, login, and updates all deserve their own
					pages. That makes CreditSoft feel like software with a real surface area, not one crammed
					homepage.
				</p>
			</div>
			<div class="route-grid">
				<a href="/features">Features</a>
				<a href="/migration">Migration</a>
				<a href="/outsourcing">Outsourcing</a>
				<a href="/videos">Videos</a>
				<a href="/updates">Updates</a>
				<a href="/login">Login</a>
			</div>
		</div>
	</section>

	<section class="section section--pricing-preview">
		<div class="section__intro">
			<div class="eyebrow">Plans</div>
			<h2>Early adopter pricing should read clearly at a glance.</h2>
		</div>
		<div class="plan-grid">
			{homePlans.map((plan) => (
				<article class={`plan-card ${plan.highlighted ? 'plan-card--highlighted' : ''}`}>
					<div class="plan-card__curl">
						<span>Sale</span>
						<em>{plan.listPrice}</em>
					</div>
					<div class="plan-card__pill">{plan.badge}</div>
					<h3>{plan.name}</h3>
					<p class="plan-card__price">{plan.price}</p>
					<p class="plan-card__copy">{plan.copy}</p>
				</article>
			))}
		</div>
	</section>

	<section class="section">
		<div class="section__split">
			<div>
				<div class="eyebrow">Proof</div>
				<h2>Use the website to show traction, not just product language.</h2>
				<div class="proof-grid">
					{reviews.map((review) => (
						<article class="proof-block">
							<h3>{review.reviewerName}</h3>
							<p>{review.quote}</p>
						</article>
					))}
				</div>
			</div>
			{featuredAd ? (
				<aside class="qualify-preview">
					{featuredAd.imageUrl ? (
						<img class="promo-image" src={featuredAd.imageUrl} alt={featuredAd.title} loading="lazy" />
					) : null}
					<div class="eyebrow">{featuredAd.eyebrow}</div>
					<h3>{featuredAd.title}</h3>
					<p class="lede">{featuredAd.copy}</p>
					<a class="button button--secondary" href={featuredAd.linkUrl} target="_blank" rel="noreferrer">
						{featuredAd.ctaLabel}
					</a>
				</aside>
			) : null}
		</div>
	</section>

	<section class="final-cta">
		<div>
			<div class="eyebrow">Office fit</div>
			<h2>Start with the quick contact step, then move into the real office questionnaire.</h2>
		</div>
		<form class="starter-form" action="/subscribe" method="get">
			<input type="hidden" name="step" value="qualify" />
			<label>
				<span>Name</span>
				<input type="text" name="name" placeholder="Your name" required />
			</label>
			<label>
				<span>Email</span>
				<input type="email" name="email" placeholder="you@company.com" required />
			</label>
			<label>
				<span>Company</span>
				<input type="text" name="company" placeholder="CreditSoft App" />
			</label>
			<button class="button button--primary" type="submit">Go to Step Two</button>
		</form>
	</section>
</Layout>
