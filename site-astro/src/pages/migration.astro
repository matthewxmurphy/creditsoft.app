---
import PageHero from '../components/PageHero.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout title="Migration | CreditSoft" description="Move clients, workflows, websites, and operating habits without rebuilding the whole office at once.">
	<PageHero
		eyebrow="Migration"
		title="Migration should lower the switching cost, not become its own project."
		copy="CreditSoft is being shaped around the real migration questions offices ask: current client count, workflow system, monitoring mix, merchant setup, website quality, and outsourcing dependency."
	/>

	<section class="section">
		<div class="two-column-copy">
			<div>
				<h2>What we pull forward first</h2>
				<ul class="bullet-list">
					<li>Client roster and ownership</li>
					<li>Letter libraries and variable cleanup</li>
					<li>Monitoring/provider credentials you actually use</li>
					<li>Website and portal expectations</li>
				</ul>
			</div>
			<div>
				<h2>What gets reviewed with a human</h2>
				<ul class="bullet-list">
					<li>Field mapping and old-header matching</li>
					<li>Merchant and billing assumptions</li>
					<li>Outsourcing habits that can be replaced by automation</li>
					<li>Whether the office actually likes its current public site</li>
				</ul>
			</div>
		</div>
	</section>
</Layout>
