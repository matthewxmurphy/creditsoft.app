---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import AccountAccess from "../components/AccountAccess.astro";
import { loadThemePage } from "../lib/preview-content";

const theme = await loadThemePage();
---

<BaseLayout
  title="Sign in | CreditSoft"
  description="Sign in to CreditSoft account billing, license, downloads, API license code, and office workspace."
  path="/sign-in"
  showChat={false}
>
  <SiteHeader topbarText={theme.topbarText} topbarEmail={theme.topbarEmail} />

  <main>
    <AccountAccess
      eyebrow="Sign in"
      title="Start with the account, then continue into the office workspace."
      text="Payment history, billing, balances, downloads, license keys, API license code, and account updates should be visible from every CreditSoft portal/login lane."
    />
  </main>

  <SiteFooter summary={theme.footer.summary} contact={theme.footer.contact} />
</BaseLayout>
