---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import AccountAccess from "../components/AccountAccess.astro";
import { loadThemePage } from "../lib/preview-content";

const theme = await loadThemePage();
---

<BaseLayout
  title="Login | CreditSoft"
  description="CreditSoft login for account billing history, license access, downloads, API license code, and the protected office workspace."
  path="/login"
  showChat={false}
>
  <SiteHeader topbarText={theme.topbarText} topbarEmail={theme.topbarEmail} />
  <main>
    <AccountAccess />
  </main>
  <SiteFooter summary={theme.footer.summary} contact={theme.footer.contact} />
</BaseLayout>
