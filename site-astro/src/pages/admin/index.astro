---
import {
	ADMIN_AUTH_MODE,
	ADMIN_SESSION_KEY,
	adminNavigation,
} from "../../lib/admin";
import {
	loadLeads,
	loadLicenses,
	loadPayments,
	loadPlans,
	loadPrivacyRequests,
	loadReviews,
} from "../../lib/site-data";

const [leadResult, paymentResult, planResult, reviewResult, licenseResult, privacyResult] = await Promise.all([
	loadLeads(Astro.cookies),
	loadPayments(Astro.cookies),
	loadPlans(Astro.cookies),
	loadReviews(Astro.cookies),
	loadLicenses(Astro.cookies),
	loadPrivacyRequests(Astro.cookies),
]);

const leads = leadResult.data;
const payments = paymentResult.data;
const plans = planResult.data;
const reviews = reviewResult.data;
const licenses = licenseResult.data;
const privacyRequests = privacyResult.data;

const revenueLift = new Intl.NumberFormat("en-US", {
	style: "currency",
	currency: "USD",
	maximumFractionDigits: 0,
}).format(payments.reduce((sum, payment) => sum + payment.amount, 0));

const adminSummary = {
	plans: plans.length,
	leads: leads.length,
	licenses: licenses.filter((entry) => entry.status === "active").length,
	payments: payments.length,
	requests: privacyRequests.filter((entry) => entry.status !== "completed").length,
	reviews: reviews.length,
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>CreditSoft Website Admin</title>
		<meta name="description" content="CreditSoft website operations dashboard." />
		<style>
			:root {
				color-scheme: dark;
				--bg: #0a0f1d;
				--panel: rgba(16, 20, 33, 0.92);
				--panel-2: rgba(19, 25, 39, 0.88);
				--cream: #f7f1df;
				--text: #f5f8ff;
				--muted: rgba(245, 248, 255, 0.68);
				--line: rgba(255, 255, 255, 0.08);
				--accent: #8fd4ff;
				--accent-2: #b6f0c4;
				--gold: #f2d2a0;
			}

			html, body {
				margin: 0;
				min-height: 100%;
				background:
					radial-gradient(circle at 15% 8%, rgba(143, 212, 255, 0.18), transparent 26%),
					radial-gradient(circle at 88% 16%, rgba(182, 240, 196, 0.12), transparent 20%),
					linear-gradient(180deg, #050814, #0c1120 42%, #111627);
				color: var(--text);
				font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
			}

			body {
				opacity: 0;
				transition: opacity 180ms ease;
			}

			body::before {
				content: "";
				position: fixed;
				inset: 0;
				pointer-events: none;
				background-image: linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px);
				background-size: 48px 48px;
				mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.62), transparent 90%);
			}

			.shell {
				position: relative;
				max-width: 1440px;
				margin: 0 auto;
				padding: 20px 18px 34px;
			}

			.topbar {
				display: flex;
				justify-content: space-between;
				align-items: center;
				gap: 18px;
				margin-bottom: 18px;
				padding: 16px 18px;
				border-radius: 24px;
				border: 1px solid var(--line);
				background: rgba(13, 18, 33, 0.92);
				box-shadow: 0 20px 50px rgba(0, 0, 0, 0.24);
			}

			.brand {
				display: flex;
				flex-direction: column;
				gap: 4px;
			}

			.brand strong {
				font-size: 0.76rem;
				letter-spacing: 0.34em;
				text-transform: uppercase;
				color: rgba(245, 248, 255, 0.56);
			}

			.brand span {
				font-size: 1.25rem;
				font-weight: 800;
			}

			.topbar .meta {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 10px;
				color: var(--muted);
				font-size: 0.9rem;
			}

			.pill {
				display: inline-flex;
				align-items: center;
				gap: 0.4rem;
				padding: 0.42rem 0.75rem;
				border-radius: 999px;
				background: rgba(143, 212, 255, 0.14);
				color: #d8edff;
				font-size: 0.72rem;
				font-weight: 700;
				letter-spacing: 0.18em;
				text-transform: uppercase;
			}

			.layout {
				display: grid;
				grid-template-columns: 225px minmax(0, 1fr);
				gap: 18px;
			}

			.sidebar,
			.content {
				border-radius: 28px;
				border: 1px solid var(--line);
				background: linear-gradient(180deg, rgba(15, 20, 36, 0.96), rgba(9, 14, 26, 0.92));
				box-shadow: 0 24px 64px rgba(0, 0, 0, 0.28);
			}

			.sidebar {
				padding: 18px;
				position: sticky;
				top: 18px;
				align-self: start;
			}

			.sidebar h2,
			.section h2 {
				margin: 0;
				font-size: 1.02rem;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: rgba(245, 248, 255, 0.55);
			}

			.sidebar nav {
				display: grid;
				gap: 10px;
				margin-top: 14px;
			}

			.sidebar a {
				text-decoration: none;
				color: var(--text);
				padding: 12px 14px;
				border-radius: 18px;
				background: rgba(255,255,255,0.04);
				border: 1px solid rgba(255,255,255,0.06);
			}

			.sidebar a strong {
				display: block;
				margin-bottom: 3px;
				font-size: 0.96rem;
			}

			.sidebar a span {
				color: var(--muted);
				font-size: 0.82rem;
			}

			.content {
				padding: 18px;
			}

			.hero {
				display: grid;
				grid-template-columns: minmax(0, 1.3fr) minmax(260px, 0.7fr);
				gap: 16px;
				margin-bottom: 18px;
			}

			.hero-panel,
			.hero-aside,
			.section,
			.stat {
				border-radius: 24px;
				border: 1px solid rgba(255,255,255,0.08);
				background: rgba(255,255,255,0.04);
			}

			.hero-panel {
				padding: 22px;
			}

			.hero-panel h1 {
				margin: 12px 0 12px;
				font-size: clamp(2rem, 3vw, 3.25rem);
				line-height: 0.96;
				letter-spacing: -0.06em;
			}

			.hero-panel p {
				margin: 0;
				max-width: 64ch;
				color: var(--muted);
				line-height: 1.72;
			}

			.hero-grid {
				display: grid;
				grid-template-columns: repeat(4, minmax(0, 1fr));
				gap: 12px;
				margin-top: 18px;
			}

			.stat {
				padding: 16px 18px;
			}

			.stat strong {
				display: block;
				margin-bottom: 4px;
				font-size: 1.4rem;
			}

			.stat span {
				color: var(--muted);
				font-size: 0.84rem;
			}

			.hero-aside {
				padding: 18px;
				display: grid;
				align-content: start;
				gap: 12px;
			}

			.hero-aside h3 {
				margin: 0;
				font-size: 1rem;
			}

			.hero-aside p {
				margin: 0;
				color: var(--muted);
				line-height: 1.5;
				font-size: 0.92rem;
			}

			.section-grid {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 16px;
			}

			.section {
				padding: 18px;
			}

			.section header {
				display: flex;
				justify-content: space-between;
				gap: 12px;
				align-items: end;
				margin-bottom: 14px;
			}

			.section h3 {
				margin: 8px 0 0;
				font-size: 1.18rem;
			}

			.section .note {
				color: var(--muted);
				font-size: 0.9rem;
				margin-top: 6px;
			}

			.plan-grid {
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: 12px;
			}

			.plan {
				padding: 16px;
				border-radius: 22px;
				background: linear-gradient(180deg, rgba(255,255,255,0.06), rgba(255,255,255,0.03));
				border: 1px solid rgba(255,255,255,0.08);
			}

			.plan .price {
				display: flex;
				align-items: baseline;
				gap: 10px;
				margin: 12px 0 8px;
			}

			.plan .price strong {
				font-size: 1.9rem;
			}

			.plan .price span {
				color: var(--muted);
				text-decoration: line-through;
				font-size: 0.96rem;
			}

			.plan ul {
				margin: 10px 0 0;
				padding-left: 18px;
				color: var(--muted);
				line-height: 1.65;
			}

			.table {
				display: grid;
				gap: 10px;
			}

			.row {
				display: grid;
				grid-template-columns: 1.3fr 1.1fr 0.8fr 0.8fr;
				gap: 10px;
				align-items: center;
				padding: 13px 14px;
				border-radius: 18px;
				background: rgba(255,255,255,0.03);
				border: 1px solid rgba(255,255,255,0.06);
			}

			.row small {
				color: var(--muted);
				display: block;
				margin-top: 2px;
			}

			.badge {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				padding: 0.35rem 0.65rem;
				border-radius: 999px;
				font-size: 0.74rem;
				font-weight: 700;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				background: rgba(143, 212, 255, 0.16);
				color: #d8edff;
			}

			.badge.green {
				background: rgba(182, 240, 196, 0.14);
				color: #d8ffe0;
			}

			.badge.gold {
				background: rgba(242, 210, 160, 0.16);
				color: #f9e4c0;
			}

			.badge.red {
				background: rgba(255, 174, 174, 0.14);
				color: #ffd4d4;
			}

			.dual {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 16px;
			}

			.action-box {
				padding: 16px;
				border-radius: 20px;
				background: rgba(255,255,255,0.03);
				border: 1px solid rgba(255,255,255,0.06);
			}

			.action-box h4 {
				margin: 0 0 10px;
				font-size: 1rem;
			}

			.action-box form {
				display: grid;
				gap: 10px;
			}

			.action-box label {
				display: grid;
				gap: 6px;
				font-size: 0.86rem;
				color: rgba(245, 248, 255, 0.74);
			}

			.action-box input,
			.action-box select {
				appearance: none;
				border-radius: 14px;
				padding: 0.82rem 0.9rem;
				border: 1px solid rgba(255,255,255,0.1);
				background: rgba(255,255,255,0.04);
				color: var(--text);
			}

			.actions {
				display: flex;
				flex-wrap: wrap;
				gap: 10px;
				align-items: center;
				margin-top: 6px;
			}

			.btn {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				padding: 0.82rem 1rem;
				border-radius: 14px;
				border: 0;
				font-weight: 700;
				cursor: pointer;
				text-decoration: none;
			}

			.btn.primary {
				background: linear-gradient(135deg, var(--accent), var(--accent-2));
				color: #08111d;
			}

			.btn.ghost {
				background: rgba(255,255,255,0.04);
				color: var(--text);
				border: 1px solid rgba(255,255,255,0.08);
			}

			#activity {
				display: grid;
				gap: 8px;
			}

			.activity-item {
				padding: 12px 13px;
				border-radius: 16px;
				background: rgba(255,255,255,0.035);
				border: 1px solid rgba(255,255,255,0.06);
				color: var(--muted);
				font-size: 0.9rem;
				line-height: 1.5;
			}

			.footer-note {
				margin-top: 14px;
				color: rgba(245, 248, 255, 0.58);
				font-size: 0.84rem;
			}

			@media (max-width: 1180px) {
				.layout {
					grid-template-columns: 1fr;
				}

				.sidebar {
					position: static;
				}
			}

			@media (max-width: 980px) {
				.hero,
				.section-grid,
				.dual,
				.hero-grid {
					grid-template-columns: 1fr;
				}

				.row {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body class="admin-loading">
		<div class="shell">
			<header class="topbar">
				<div class="brand">
					<strong>CreditSoft</strong>
					<span>Website operations console</span>
				</div>
				<div class="meta">
					<span class="pill">Admin</span>
					<span>Mode: {ADMIN_AUTH_MODE}</span>
					<a class="btn ghost" href="/admin/logout" style="text-decoration:none;">Logout</a>
				</div>
			</header>

			<div class="layout">
				<aside class="sidebar" aria-label="Admin sections">
					<h2>Sections</h2>
					<nav>
						{adminNavigation.map((item) => (
							<a href={`#${item.id}`}>
								<strong>{item.label}</strong>
								<span>{item.note}</span>
							</a>
						))}
					</nav>
				</aside>

				<main class="content">
					<section class="hero" id="overview">
						<div class="hero-panel">
							<div class="pill">Website ops</div>
							<h1>Plans, leads, licenses, payments, legal, and reviews in one place.</h1>
							<p>
								This is the website admin shell for CreditSoft. It keeps the public sales site,
								update lane, and admin actions close together without dragging the intranet into the
								mix.
							</p>

							<div class="hero-grid">
								<div class="stat">
									<strong>{revenueLift}</strong>
									<span>MRR / revenue snapshot</span>
								</div>
								<div class="stat">
									<strong>{adminSummary.leads}</strong>
									<span>Open leads in the sales pipeline</span>
								</div>
								<div class="stat">
									<strong>{adminSummary.licenses}</strong>
									<span>Active licenses</span>
								</div>
								<div class="stat">
									<strong>{adminSummary.requests}</strong>
									<span>Privacy / legal requests pending</span>
								</div>
							</div>
						</div>

						<div class="hero-aside">
							<h3>Quick snapshot</h3>
							<p><strong>{adminSummary.plans}</strong> plans are ready to publish or adjust sale pricing.</p>
							<p><strong>{adminSummary.payments}</strong> payment records are visible for review and follow-up.</p>
							<p><strong>{adminSummary.reviews}</strong> reviews are queued for reply or proof capture.</p>
						</div>
					</section>

					<div class="section-grid">
						<section class="section" id="plans">
							<header>
								<div>
									<h2>Plans</h2>
									<h3>Plan pricing and discount controls</h3>
								</div>
								<div class="badge gold">Edit sale pricing</div>
							</header>

							<div class="plan-grid">
								{plans.map((plan) => (
									<article class="plan">
										<div class="badge green">{plan.badge ?? "Published plan"}</div>
										<h4>{plan.name}</h4>
										<div class="price">
											<strong>${(plan.saleMonthlyPrice ?? plan.monthlyPrice).toFixed(2)}</strong>
											<span>${plan.monthlyPrice.toFixed(2)}</span>
										</div>
										<div class="badge">{plan.annualDiscountPercent ? `${plan.annualDiscountPercent}% annual` : "Monthly"}</div>
										<ul>
											{plan.features.map((feature) => <li>{feature}</li>)}
										</ul>
									</article>
								))}
							</div>
						</section>

						<section class="section" id="leads">
							<header>
								<div>
									<h2>Leads</h2>
									<h3>Lead intake and follow-up</h3>
								</div>
								<div class="badge">Hot pipeline</div>
							</header>

							<div class="table">
								{leads.length > 0 ? leads.map((lead) => (
									<div class="row">
										<div>
											<strong>{lead.name}</strong>
											<small>{lead.email}</small>
										</div>
										<div>
											{lead.company ?? 'No company yet'}
											<small>{lead.source}</small>
										</div>
										<div>{lead.status}</div>
										<div>{new Date(lead.updatedAt).toLocaleDateString()}</div>
									</div>
								)) : (
									<div class="row">
										<div>
											<strong>No leads yet</strong>
											<small>The two-step intake is ready and waiting for the first real office profile.</small>
										</div>
										<div>Lead flow live</div>
										<div>Ready</div>
										<div>Now</div>
									</div>
								)}
							</div>
						</section>
					</div>

					<div class="section-grid" style="margin-top: 16px;">
						<section class="section" id="licenses">
							<header>
								<div>
									<h2>Licenses</h2>
									<h3>Issue and extend licenses</h3>
								</div>
								<div class="badge">Admin only</div>
							</header>

							<div class="table">
								{licenses.map((license) => (
									<div class="row">
										<div>
											<strong>{license.licenseKey}</strong>
											<small>{license.customerName ?? license.email}</small>
										</div>
										<div>
											{license.planKey}
											<small>{license.notes ?? "Ready to extend or review"}</small>
										</div>
										<div>{license.status}</div>
										<div>{license.expiresAt ? new Date(license.expiresAt).toLocaleDateString() : "No expiry"}</div>
									</div>
								))}
							</div>

							<div class="dual" style="margin-top: 14px;">
								<div class="action-box">
									<h4>Issue license</h4>
									<form>
										<label>
											Customer
											<input type="text" placeholder="Customer name or email" />
										</label>
										<label>
											Plan
											<select>
												<option>Starter</option>
												<option>Pro</option>
												<option>Enterprise</option>
											</select>
										</label>
										<button class="btn primary" type="button">Issue</button>
									</form>
								</div>

								<div class="action-box">
									<h4>Extend license</h4>
									<form>
										<label>
											License ID
											<input type="text" placeholder="LIC-1042" />
										</label>
										<label>
											Extend by
											<select>
												<option>30 days</option>
												<option>60 days</option>
												<option>90 days</option>
											</select>
										</label>
										<button class="btn primary" type="button">Extend</button>
									</form>
								</div>
							</div>
						</section>

						<section class="section" id="payments">
							<header>
								<div>
									<h2>Payments</h2>
									<h3>Payment history and status</h3>
								</div>
								<div class="badge green">Captured and pending</div>
							</header>

							<div class="table">
								{payments.map((payment) => (
									<div class="row">
										<div>
											<strong>{payment.customerName}</strong>
											<small>{new Date(payment.paidAt).toLocaleDateString()}</small>
										</div>
										<div>${payment.amount.toFixed(2)}</div>
										<div>{payment.method}</div>
										<div>
											{payment.status}
										</div>
									</div>
								))}
							</div>
						</section>
					</div>

					<div class="section-grid" style="margin-top: 16px;">
						<section class="section" id="legal">
							<header>
								<div>
									<h2>Legal / privacy</h2>
									<h3>Delete-my-info and request handling</h3>
								</div>
								<div class="badge red">Requires review</div>
							</header>

							<div class="table">
								{privacyRequests.map((request) => (
									<div class="row">
										<div>
											<strong>{request.requestType}</strong>
											<small>{request.email}</small>
										</div>
										<div>{request.status}</div>
										<div>{new Date(request.createdAt).toLocaleDateString()}</div>
										<div>{request.details ?? "Needs follow-up"}</div>
									</div>
								))}
							</div>
						</section>

						<section class="section" id="reviews">
							<header>
								<div>
									<h2>Reviews</h2>
									<h3>Review manager and reply queue</h3>
								</div>
								<div class="badge">Public proof</div>
							</header>

							<div class="table">
								{reviews.map((review) => (
									<div class="row" style="grid-template-columns: 1.1fr 0.8fr 0.6fr 1fr;">
										<div>
											<strong>{review.reviewerName}</strong>
											<small>{review.source ?? 'Imported review'}</small>
										</div>
										<div>{review.rating.toFixed(1)}</div>
										<div>{review.active ? 'Published' : 'Hidden'}</div>
										<div>{review.quote}</div>
									</div>
								))}
							</div>
						</section>
					</div>

					<div class="footer-note">
						Current auth mode is <strong>{ADMIN_AUTH_MODE}</strong>. Use the logout link above to
						clear the local fallback session.
					</div>
				</main>
			</div>
		</div>

		<script type="module" define:vars={{ sessionKey: ADMIN_SESSION_KEY, loginPath: "/admin/login" }}>
			function readSession() {
				try {
					const raw = localStorage.getItem(sessionKey);
					if (!raw) return null;
					const session = JSON.parse(raw);
					if (!session?.email || !session?.expiresAt || session.expiresAt <= Date.now()) {
						localStorage.removeItem(sessionKey);
						return null;
					}
					return session;
				} catch {
					return null;
				}
			}

			const session = readSession();
			if (!session) {
				location.replace(loginPath);
			} else {
				document.body.style.opacity = "1";
			}
		</script>
	</body>
</html>
