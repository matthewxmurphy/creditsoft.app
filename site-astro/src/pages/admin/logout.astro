---
import { ADMIN_SESSION_KEY } from "../../lib/admin";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Signing out</title>
		<style>
			html, body {
				margin: 0;
				min-height: 100%;
				background: #0a0f1d;
				color: #f5f8ff;
				font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
			}

			body {
				display: grid;
				place-items: center;
			}

			.card {
				max-width: 520px;
				padding: 28px;
				border-radius: 24px;
				background: rgba(15, 20, 35, 0.94);
				border: 1px solid rgba(255,255,255,0.08);
				box-shadow: 0 28px 72px rgba(0,0,0,0.35);
			}

			p {
				color: rgba(245, 248, 255, 0.7);
				line-height: 1.6;
			}

			a {
				color: #08111c;
				background: linear-gradient(135deg, #8fd0ff, #aef0bc);
				padding: 0.9rem 1rem;
				border-radius: 14px;
				font-weight: 700;
				text-decoration: none;
				display: inline-flex;
				margin-top: 12px;
			}
		</style>
	</head>
	<body>
		<div class="card">
			<h1>Signing you out</h1>
			<p>The fallback admin session is being cleared now.</p>
			<a href="/admin/login">Back to login</a>
		</div>

		<script type="module" define:vars={{ sessionKey: ADMIN_SESSION_KEY, loginPath: "/admin/login" }}>
			localStorage.removeItem(sessionKey);
			location.replace(loginPath + "?signed-out=1");
		</script>
	</body>
</html>
