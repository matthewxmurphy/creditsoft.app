---
import PageHero from '../components/PageHero.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout title="Videos | CreditSoft" description="Training and rollout videos for CreditSoft.">
	<PageHero
		eyebrow="Videos"
		title="Training gets its own page, even before the full library is finished."
		copy="A real software company should have a proper training lane. The player and catalog can grow, but the route should already exist."
	/>

	<section class="section">
		<div class="video-placeholder">
			<div class="video-placeholder__screen">HTML5 player lane ready</div>
			<div class="video-placeholder__copy">
				<h2>Coming soon</h2>
				<p>Drop in the first MP4 and poster image here, then expand into a searchable training library as the product grows.</p>
			</div>
		</div>
	</section>
</Layout>
