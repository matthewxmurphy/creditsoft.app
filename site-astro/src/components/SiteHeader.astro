---
const {
  topbarText = "Metro2-first credit repair software with AI-assisted review, local-first office nodes, client portals, and compliance workflows.",
  topbarEmail = "hello@creditsoft.app",
} = Astro.props;

const links = [
  {
    href: "/features",
    label: "Features",
    menu: "wide",
    children: [
      { href: "/features", label: "Feature overview", text: "The full CreditSoft product map.", icon: "overview" },
      { href: "/local-first-crm", label: "Local-first CRM", text: "Leads, clients, billing signals, and office workflow.", icon: "crm" },
      { href: "/metro2", label: "Metro2 review", text: "AI-assisted issue detection from report data.", icon: "metro2" },
      { href: "/client-portal", label: "Client portal", text: "Client-safe uploads, updates, letters, and status.", icon: "portal" },
      { href: "/api-bridge", label: "API bridge", text: "Website, portal, and callback lanes into the intranet.", icon: "bridge" },
      { href: "/multi-office-nodes", label: "Multi-office nodes", text: "Replica roles, weak-node limits, and backup lanes.", icon: "nodes" },
      { href: "/compliance", label: "FCRA / FDCPA", text: "Federal compliance workflow and claim indicators.", icon: "compliance" },
      { href: "/email-providers", label: "Email providers", text: "Microsoft 365, Google, SES, SMTP, and delivery lanes.", icon: "email" },
    ],
  },
  {
    href: "https://admin.creditsoft.app",
    label: "Office",
    align: "right",
    menu: "compact",
    children: [
      { href: "https://admin.creditsoft.app", label: "Login", text: "Open the protected office system on admin.creditsoft.app.", icon: "login" },
      { href: "/backup-redundancy", label: "Backup redundancy", text: "Office nodes protect each other instead of one box.", icon: "backup" },
      { href: "/tech-stack", label: "Tech stack", text: "PostgreSQL, callbacks, PWA, and handled installs.", icon: "stack" },
      { href: "/social-media", label: "Social / Meta manager", text: "Graph API, content calendar, creator goals, and lead handoff.", icon: "social" },
    ],
  },
  { href: "/migration", label: "Migration" },
  { href: "/outsourcing", label: "Outsourcing" },
  { href: "/videos", label: "Videos" },
  { href: "/pricing-plan", label: "Pricing" },
];

const icons = {
  overview: "M4 5.5A1.5 1.5 0 0 1 5.5 4h13A1.5 1.5 0 0 1 20 5.5v13a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 18.5v-13Zm4 2.75h8M8 12h8M8 15.75h5",
  crm: "M7.5 9.75a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM3.75 20.25v-1.5A3.75 3.75 0 0 1 7.5 15h.75M16.5 11.25a2.25 2.25 0 1 0 0-4.5 2.25 2.25 0 0 0 0 4.5Zm-4.5 9v-1.125A3.375 3.375 0 0 1 15.375 15h2.25A3.375 3.375 0 0 1 21 18.375v1.875",
  metro2: "M4 18.5 9.4 13l3.3 3.3L20 8.75M14.75 8.75H20V14",
  portal: "M5.5 4.75h13A1.5 1.5 0 0 1 20 6.25v11.5a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 17.75V6.25a1.5 1.5 0 0 1 1.5-1.5ZM4 8.5h16M8.25 13h7.5M8.25 16h4.5",
  bridge: "M8.25 12h7.5M7 15.75h-.75a3.75 3.75 0 0 1 0-7.5H7m10 0h.75a3.75 3.75 0 0 1 0 7.5H17",
  nodes: "M6.5 7.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Zm11 0a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Zm-5.5 14a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5ZM8.4 8.7l2.2 6.2m5-6.2-2.2 6.2M9 18.25H6.5A2.5 2.5 0 0 1 4 15.75V13",
  compliance: "M12 3.75 19 6.5v5.25c0 4.25-2.78 7.15-7 8.5-4.22-1.35-7-4.25-7-8.5V6.5l7-2.75Zm-3 8.5 2 2 4-4",
  email: "M4.75 6h14.5A1.75 1.75 0 0 1 21 7.75v8.5A1.75 1.75 0 0 1 19.25 18H4.75A1.75 1.75 0 0 1 3 16.25v-8.5A1.75 1.75 0 0 1 4.75 6Zm-.5 2.1 6.55 4.65a2 2 0 0 0 2.4 0l6.55-4.65",
  login: "M9.5 6.5V5A1.5 1.5 0 0 1 11 3.5h7A1.5 1.5 0 0 1 19.5 5v14A1.5 1.5 0 0 1 18 20.5h-7A1.5 1.5 0 0 1 9.5 19v-1.5M4 12h9m0 0-3-3m3 3-3 3",
  backup: "M6.5 8.5A5.5 5.5 0 0 1 17 6.25L19 8.5m-1.5 7A5.5 5.5 0 0 1 7 17.75L5 15.5M19 5.5v3h-3M5 18.5v-3h3",
  stack: "M12 3.75 20 7.5l-8 3.75-8-3.75 8-3.75Zm-6.5 7L12 13.8l6.5-3.05M5.5 14.25 12 17.3l6.5-3.05",
  social: "M8.5 12.25a2.25 2.25 0 1 0 0-4.5 2.25 2.25 0 0 0 0 4.5Zm7-5a2 2 0 1 0 0-4 2 2 0 0 0 0 4Zm0 13.5a2 2 0 1 0 0-4 2 2 0 0 0 0 4Zm-5.1-9.25 3.2 4.05m.05-8.05-3.25 2.6",
  video: "M5.5 6.5h9A2.5 2.5 0 0 1 17 9v6a2.5 2.5 0 0 1-2.5 2.5h-9A2.5 2.5 0 0 1 3 15V9a2.5 2.5 0 0 1 2.5-2.5Zm13 3 2.5-1.5v8l-2.5-1.5V9.5Zm-10 1.25 3.75 2.25-3.75 2.25v-4.5Z",
  default: "M5 6.5h14M5 12h14M5 17.5h14",
};
---

<header class="site-header">
  <div class="utility-bar">
    <div class="page-wrap utility-inner">
      <span>{topbarText}</span>
      <a class="utility-email" href={`mailto:${topbarEmail}`}>
        <span class="utility-email-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d={icons.email} />
          </svg>
        </span>
        {topbarEmail}
      </a>
    </div>
  </div>

  <div class="nav-bar">
    <div class="page-wrap nav-inner">
      <a class="brand" href="/" aria-label="CreditSoft home">
        <img src="/brand/creditsoft-wordmark.png" alt="CreditSoft.app" width="1073" height="282" decoding="async" />
      </a>

      <nav class="nav-links" aria-label="Primary">
        {links.map((link) => (
          link.children ? (
            <div class="nav-item">
              <a class="nav-trigger" href={link.href} aria-haspopup="true">
                {link.label}
                <svg viewBox="0 0 20 20" aria-hidden="true">
                  <path d="M5.2 7.3a1 1 0 0 1 1.4 0L10 10.7l3.4-3.4a1 1 0 0 1 1.4 1.4l-4.1 4.1a1 1 0 0 1-1.4 0L5.2 8.7a1 1 0 0 1 0-1.4Z" />
                </svg>
              </a>
              <div class={`nav-menu ${link.menu === "compact" ? "nav-menu--compact" : ""} ${link.align === "right" ? "nav-menu--right" : ""}`} role="menu">
                {link.children.map((item) => (
                  <a href={item.href} role="menuitem">
                    <span class="nav-menu-icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24">
                        <path d={icons[item.icon] ?? icons.default} />
                      </svg>
                    </span>
                    <span class="nav-menu-copy">
                      <strong>{item.label}</strong>
                      <span>{item.text}</span>
                    </span>
                  </a>
                ))}
              </div>
            </div>
          ) : (
            <a href={link.href}>{link.label}</a>
          )
        ))}
      </nav>

      <div class="nav-actions">
        <a class="login-link" href="/login">Login</a>
        <a class="video-action" href="/videos">Videos</a>
        <a class="button primary nav-cta" href="/subscribe">Sign up</a>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    backdrop-filter: blur(16px);
    background: linear-gradient(180deg, rgba(8, 8, 10, 0.92), rgba(8, 8, 10, 0.74));
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .utility-bar {
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    color: var(--muted);
    font-size: 0.88rem;
  }

  .utility-inner,
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
  }

  .utility-inner {
    min-height: 40px;
  }

  .utility-email {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text-soft);
    font-weight: 700;
    white-space: nowrap;
  }

  .utility-email-icon {
    display: inline-grid;
    flex: 0 0 auto;
    width: 29px;
    height: 29px;
    place-items: center;
    color: #5bd695;
    filter: drop-shadow(0 0 14px rgba(91, 214, 149, 0.28));
  }

  .utility-email-icon svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2.15;
  }

  .utility-email:hover {
    color: var(--text);
  }

  .utility-email:hover .utility-email-icon {
    color: var(--accent);
    filter: drop-shadow(0 0 14px rgba(241, 194, 122, 0.3));
  }

  .nav-inner {
    min-height: 82px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    flex: 0 1 224px;
    min-width: 166px;
  }

  .brand img {
    width: min(100%, 224px);
    height: auto;
    max-height: 59px;
    border-radius: 8px;
    filter: drop-shadow(0 14px 24px rgba(0, 0, 0, 0.3));
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 28px;
    justify-content: center;
    min-width: 0;
    font-size: 1rem;
    color: var(--text-soft);
  }

  .nav-item {
    position: relative;
  }

  .nav-trigger {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
  }

  .nav-trigger svg {
    width: 16px;
    height: 16px;
    fill: currentColor;
  }

  .nav-links a {
    transition: color 180ms ease;
  }

  .nav-links > a {
    white-space: nowrap;
  }

  .nav-links a:hover,
  .login-link:hover {
    color: var(--text);
  }

  .nav-menu {
    position: absolute;
    left: 50%;
    top: calc(100% + 18px);
    display: grid;
    width: min(640px, calc(100vw - 48px));
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
    padding: 12px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 18px;
    background: rgba(15, 15, 20, 0.98);
    box-shadow: 0 24px 56px rgba(0, 0, 0, 0.38);
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, -8px);
    transition:
      opacity 160ms ease,
      transform 160ms ease;
  }

  .nav-menu::before {
    content: "";
    position: absolute;
    inset: -20px 0 auto;
    height: 20px;
  }

  .nav-menu::after {
    content: "";
    position: absolute;
    top: -8px;
    left: calc(50% - 8px);
    width: 16px;
    height: 16px;
    background: rgba(15, 15, 20, 0.98);
    border-left: 1px solid rgba(255, 255, 255, 0.1);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    transform: rotate(45deg);
  }

  .nav-menu--compact {
    width: min(560px, calc(100vw - 48px));
    grid-template-columns: 1fr;
  }

  .nav-menu--right {
    right: 0;
    left: auto;
    transform: translate(0, -8px);
  }

  .nav-menu--right::after {
    right: 30px;
    left: auto;
  }

  .nav-item:hover .nav-menu,
  .nav-item:focus-within .nav-menu {
    opacity: 1;
    pointer-events: auto;
    transform: translate(-50%, 0);
  }

  .nav-item:hover .nav-menu--right,
  .nav-item:focus-within .nav-menu--right {
    transform: translate(0, 0);
  }

  .nav-menu a {
    display: grid;
    grid-template-columns: 46px minmax(0, 1fr);
    align-items: start;
    gap: 14px;
    padding: 14px;
    border-radius: 12px;
    color: var(--text-soft);
    min-width: 0;
    transition:
      background 180ms ease,
      color 180ms ease,
      transform 180ms ease;
  }

  .nav-menu a:hover {
    background: rgba(241, 194, 122, 0.1);
    color: var(--text);
    transform: translateX(2px);
  }

  .nav-menu-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border-radius: 12px;
    background:
      linear-gradient(135deg, rgba(91, 214, 149, 0.16), rgba(241, 194, 122, 0.12)),
      rgba(255, 255, 255, 0.055);
    color: var(--accent-alt);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
  }

  .nav-menu-icon svg {
    width: 24px;
    height: 24px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  .nav-menu-copy {
    display: grid;
    gap: 4px;
    min-width: 0;
  }

  .nav-menu strong {
    color: var(--text);
    font-size: 0.96rem;
    line-height: 1.25;
    overflow-wrap: anywhere;
  }

  .nav-menu-copy > span {
    color: var(--muted);
    font-size: 0.84rem;
    line-height: 1.45;
    overflow-wrap: anywhere;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .login-link,
  .video-action {
    color: var(--text-soft);
    font-weight: 700;
  }

  .video-action {
    display: none;
  }

  .nav-cta {
    min-height: 52px;
    padding-inline: 22px;
    border-radius: 16px;
    white-space: nowrap;
  }

  @media (max-width: 1120px) {
    .brand {
      flex-basis: 196px;
      min-width: 154px;
    }

    .brand img {
      width: min(100%, 196px);
    }

    .nav-links {
      gap: 18px;
      font-size: 0.94rem;
    }
  }

  @media (max-width: 980px) {
    .utility-inner span:nth-child(1) {
      display: none;
    }

    .nav-links {
      display: none;
    }

    .video-action {
      display: inline-flex;
    }

    .utility-inner {
      justify-content: flex-end;
    }
  }

  @media (max-width: 720px) {
    .login-link,
    .video-action {
      display: none;
    }

    .nav-inner {
      min-height: 74px;
      gap: 12px;
    }

    .brand {
      flex-basis: 156px;
      min-width: 0;
    }

    .brand img {
      width: min(100%, 156px);
      max-height: 42px;
    }

    .nav-cta {
      min-height: 48px;
      padding-inline: 16px;
      border-radius: 14px;
      font-size: 0.94rem;
    }
  }

  @media (max-width: 380px) {
    .brand {
      flex-basis: 132px;
    }

    .brand img {
      width: min(100%, 132px);
    }

    .nav-cta {
      padding-inline: 12px;
    }
  }
</style>
