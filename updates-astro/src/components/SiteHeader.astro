---
const {
  topbarText = "Metro2-first credit repair software with local-first CRM, intranet, portal, and website lanes.",
  topbarEmail = "hello@creditsoft.app",
} = Astro.props;

const links = [
  { href: "/", label: "Home" },
  { href: "/features", label: "Features" },
  { href: "/about-us", label: "About" },
  { href: "/pricing-plan", label: "Pricing" },
  { href: "/contact-us", label: "Contact" },
];
---

<header class="site-header">
  <div class="utility-bar">
    <div class="page-wrap utility-inner">
      <span>{topbarText}</span>
      <a href={`mailto:${topbarEmail}`}>{topbarEmail}</a>
    </div>
  </div>

  <div class="nav-bar">
    <div class="page-wrap nav-inner">
      <a class="brand" href="/" aria-label="CreditSoft preview home">
        <span class="brand-mark">C</span>
        <span class="brand-copy">
          <strong>CreditSoft</strong>
          <small>Astro preview</small>
        </span>
      </a>

      <nav class="nav-links" aria-label="Primary">
        {links.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))}
      </nav>

      <div class="nav-actions">
        <a class="login-link" href="/sign-in">Sign in</a>
        <a class="button primary nav-cta" href="/pricing-plan">Start now</a>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    backdrop-filter: blur(16px);
    background: linear-gradient(180deg, rgba(8, 8, 10, 0.92), rgba(8, 8, 10, 0.74));
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .utility-bar {
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    color: var(--muted);
    font-size: 0.88rem;
  }

  .utility-inner,
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
  }

  .utility-inner {
    min-height: 40px;
  }

  .utility-inner a {
    color: var(--text-soft);
  }

  .nav-inner {
    min-height: 82px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    min-width: 190px;
  }

  .brand-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 14px;
    background: linear-gradient(135deg, #f1c27a, #a86a2d);
    color: #0c0d10;
    font-weight: 900;
    font-size: 1.3rem;
    box-shadow: 0 16px 30px rgba(241, 194, 122, 0.2);
  }

  .brand-copy {
    display: grid;
    gap: 2px;
  }

  .brand-copy strong {
    font-size: 1.22rem;
    letter-spacing: -0.03em;
  }

  .brand-copy small {
    color: var(--muted);
    font-size: 0.77rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 28px;
    justify-content: center;
    font-size: 1rem;
    color: var(--text-soft);
  }

  .nav-links a {
    transition: color 180ms ease;
  }

  .nav-links a:hover,
  .login-link:hover {
    color: var(--text);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .login-link {
    color: var(--text-soft);
    font-weight: 700;
  }

  .nav-cta {
    min-height: 52px;
    padding-inline: 22px;
    border-radius: 16px;
  }

  @media (max-width: 980px) {
    .utility-inner span:nth-child(1) {
      display: none;
    }

    .nav-links {
      display: none;
    }

    .utility-inner {
      justify-content: flex-end;
    }
  }

  @media (max-width: 720px) {
    .login-link {
      display: none;
    }

    .brand-copy small {
      display: none;
    }

    .nav-inner {
      min-height: 74px;
    }
  }
</style>
