---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { loadPlans, loadThemePage } from "../lib/preview-content";

const theme = await loadThemePage();
const plans = await loadPlans();

const money = new Intl.NumberFormat("en-US", {
  style: "currency",
  currency: "USD",
  minimumFractionDigits: 0,
  maximumFractionDigits: 2,
});
---

<BaseLayout title="CreditSoft Pricing" description="Pricing for the CreditSoft public site, CRM, portal, migration, and office-node lanes.">
  <SiteHeader topbarText={theme.topbarText} topbarEmail={theme.topbarEmail} />

  <main>
    <section class="section page-hero">
      <div class="page-wrap section-shell">
        <span class="eyebrow">Pricing</span>
        <h1 class="display">Monthly, lease, or a 10-year CreditSoft license.</h1>
        <p class="lede">
          Monthly keeps the door open. Lease terms make rollout easier to plan.
          The 10-year license is the big value anchor for offices that already know CreditSoft
          is going to be core infrastructure.
        </p>
      </div>
    </section>

    <section class="section">
      <div class="page-wrap section-shell">
        <div class="simple-grid pricing-grid stagger">
          {plans.map((plan) => (
            <article class:list={["info-card panel", plan.highlighted && "price-focus"]}>
              <span class="eyebrow">{plan.badge ?? "Plan"}</span>
              <h3>{plan.name}</h3>
              <p>{plan.description}</p>
              <div class="price-stack">
                <strong>{money.format(plan.saleMonthlyPrice ?? plan.monthlyPrice)}<small>{plan.billingLabel ?? "/month"}</small></strong>
                <span>{plan.secondaryPriceLabel ?? `${money.format(plan.annualPrice)} annually`}</span>
                {plan.annualDiscountPercent ? <em>Save {plan.annualDiscountPercent}% annually</em> : null}
              </div>
              {plan.leaseTerms && plan.leaseTerms.length > 0 ? (
                <label class="term-select">
                  <span>Lease term</span>
                  <select>
                    {plan.leaseTerms.map((term) => <option>{term}</option>)}
                  </select>
                </label>
              ) : null}
              <ul>
                {plan.featureList.map((feature) => (
                  <li>{feature}</li>
                ))}
              </ul>
              <a class:list={["button", plan.highlighted ? "primary" : "ghost"]} href="/contact-us">
                Choose {plan.name}
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="page-wrap section-shell">
        <SectionHeading
          eyebrow="Comparison"
          title="The 10-year license should feel like the obvious long-term deal."
          text="Monthly and lease options are there for normal office cashflow. The 10-year license exists for the one to three serious companies a year that want the system locked in."
        />

        <div class="compare-table panel">
          <div class="compare-row compare-head">
            <div>Feature</div>
            <div>Monthly</div>
            <div>Lease</div>
            <div>10-year</div>
          </div>
          {theme.compareRows.map((row) => (
            <div class="compare-row">
              <div>{row.feature}</div>
              <div>{row.starter}</div>
              <div>{row.plus}</div>
              <div>{row.pro}</div>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>

  <SiteFooter summary={theme.footer.summary} contact={theme.footer.contact} />
</BaseLayout>

<style>
  .pricing-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .price-stack {
    display: grid;
    gap: 6px;
    margin: 22px 0;
  }

  .price-stack strong {
    font-size: 2.6rem;
    letter-spacing: -0.05em;
  }

  .price-stack small,
  .price-stack span,
  .price-stack em {
    color: var(--muted);
  }

  .price-stack small {
    margin-left: 8px;
    font-size: 1rem;
    letter-spacing: 0;
  }

  .price-focus {
    border-color: rgba(241, 194, 122, 0.26);
    box-shadow: 0 24px 60px rgba(241, 194, 122, 0.1);
  }

  .term-select {
    display: grid;
    gap: 8px;
    margin: 0 0 18px;
    color: var(--muted);
    font-size: 0.84rem;
    font-weight: 700;
  }

  .term-select select {
    min-height: 44px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.06);
    color: var(--text);
    padding: 0 12px;
  }

  @media (max-width: 1180px) {
    .pricing-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .pricing-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
