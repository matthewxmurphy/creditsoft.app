---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { loadPlans, loadThemePage } from "../lib/preview-content";

const theme = await loadThemePage();
const plans = (await loadPlans()).slice(0, 3);

const money = new Intl.NumberFormat("en-US", {
  style: "currency",
  currency: "USD",
  maximumFractionDigits: 0,
});
---

<BaseLayout title="CreditSoft Pricing | Astro preview" description="Pricing page preview for the CreditSoft Astro replacement site.">
  <SiteHeader topbarText={theme.topbarText} topbarEmail={theme.topbarEmail} />

  <main>
    <section class="section page-hero">
      <div class="page-wrap section-shell">
        <span class="eyebrow">Pricing plan</span>
        <h1 class="display">Flexible plans built for every CreditSoft office stage.</h1>
        <p class="lede">
          This is the closer Zarex-style pricing lane: cleaner hierarchy, fewer excuses,
          and one place to understand monthly, annual, and sale positioning.
        </p>
      </div>
    </section>

    <section class="section">
      <div class="page-wrap section-shell">
        <div class="simple-grid three stagger">
          {plans.map((plan) => (
            <article class:list={["info-card panel", plan.highlighted && "price-focus"]}>
              <span class="eyebrow">{plan.badge ?? "Plan"}</span>
              <h3>{plan.name}</h3>
              <p>{plan.description}</p>
              <div class="price-stack">
                <strong>{money.format(plan.saleMonthlyPrice ?? plan.monthlyPrice)}<small>/month</small></strong>
                <span>{money.format(plan.annualPrice)} annually</span>
                {plan.annualDiscountPercent ? <em>Save {plan.annualDiscountPercent}% annually</em> : null}
              </div>
              <ul>
                {plan.featureList.map((feature) => (
                  <li>{feature}</li>
                ))}
              </ul>
              <a class:list={["button", plan.highlighted ? "primary" : "ghost"]} href="/contact-us">
                Choose {plan.name}
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="page-wrap section-shell">
        <SectionHeading
          eyebrow="Comparison"
          title="Pricing should still explain capability clearly"
          text="This keeps the theme structure while making the plan differences feel more grounded in CreditSoft."
        />

        <div class="compare-table panel">
          <div class="compare-row compare-head">
            <div>Feature</div>
            <div>Starter</div>
            <div>Growth</div>
            <div>Enterprise</div>
          </div>
          {theme.compareRows.map((row) => (
            <div class="compare-row">
              <div>{row.feature}</div>
              <div>{row.starter}</div>
              <div>{row.plus}</div>
              <div>{row.pro}</div>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>

  <SiteFooter summary={theme.footer.summary} contact={theme.footer.contact} />
</BaseLayout>

<style>
  .price-stack {
    display: grid;
    gap: 6px;
    margin: 22px 0;
  }

  .price-stack strong {
    font-size: 2.6rem;
    letter-spacing: -0.05em;
  }

  .price-stack small,
  .price-stack span,
  .price-stack em {
    color: var(--muted);
  }

  .price-focus {
    border-color: rgba(241, 194, 122, 0.26);
    box-shadow: 0 24px 60px rgba(241, 194, 122, 0.1);
  }
</style>
