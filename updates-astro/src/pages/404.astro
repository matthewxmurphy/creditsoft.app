---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="CreditSoft Updates | Not found">
  <main class="page-wrap section">
    <span class="eyebrow">404</span>
    <h1 class="display">This update lane is missing.</h1>
    <p class="lede">Head back to the homepage to find downloads, renewals, and release notes.</p>
    <div class="button-row">
      <a class="button primary" href="/">Back home</a>
      <a class="button secondary" href="/downloads">Open downloads</a>
    </div>
  </main>
</BaseLayout>
