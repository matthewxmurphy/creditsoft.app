              "elements": []
            },
            {
              "id": "0000007",
              "elType": "widget",
              "widgetType": "text-editor",
              "settings": {
                "editor": "<p>We collect information you provide directly, including name, email, company, office details, payment-reference notes, and support messages.</p>"
              },
              "elements": []
            },
            {
              "id": "0000008",
              "elType": "widget",
              "widgetType": "heading",
              "settings": {
                "title": "How We Use Information",
                "header_size": "h2"
              },
              "elements": []
            },
            {
              "id": "0000009",
              "elType": "widget",
              "widgetType": "text-editor",
              "settings": {
                "editor": "<p>We use information to provide and improve CreditSoft, create account dashboard access, match license payments, communicate with you, and meet legal and security obligations.</p>"
              },
              "elements": []
            },
            {
              "id": "000000a",
              "elType": "widget",
              "widgetType": "heading",
              "settings": {
                "title": "Local-First Client Data",
                "header_size": "h2"
              },
              "elements": []
            },
            {
              "id": "000000b",
              "elType": "widget",
              "widgetType": "text-editor",
              "settings": {
                "editor": "<p><strong>Important:</strong> CreditSoft office data is designed to run on your approved server or office node. Client case data is not treated like a shared SaaS database hosted for every customer.</p>"
              },
              "elements": []
            },
            {
              "id": "000000c",
              "elType": "widget",
              "widgetType": "heading",
              "settings": {
                "title": "Analytics And Marketing",
                "header_size": "h2"
              },
              "elements": []
            },
            {
              "id": "000000d",
              "elType": "widget",
              "widgetType": "text-editor",
              "settings": {
                "editor": "<p>We may use analytics and marketing tools such as Google Analytics and Meta Pixel after consent where required. You can decline optional cookies from the cookie banner.</p>"
              },
              "elements": []
            },
            {
              "id": "000000e",
              "elType": "widget",
              "widgetType": "heading",
              "settings": {
                "title": "Your Rights",
