            {
              "id": "0000003",
              "elType": "widget",
              "widgetType": "heading",
              "settings": {
                "title": "Multi-office nodes for different cities, states, or VA offices",
                "header_size": "h1"
              },
              "elements": []
            },
            {
              "id": "0000004",
              "elType": "widget",
              "widgetType": "text-editor",
              "settings": {
                "editor": "<p>The intended deployment is not one fragile machine. Offices can run primary, replica, and backup-light nodes in different places, with each node's backup role matched to the hardware it actually has.</p>"
              },
              "elements": []
            },
            {
