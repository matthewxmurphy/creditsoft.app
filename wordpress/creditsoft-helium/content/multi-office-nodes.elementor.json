            {
              "id": "000000b",
              "elType": "widget",
              "widgetType": "text-editor",
              "settings": {
                "editor": "<p>Click the screenshot to open the full-size shadow-box view. This page should never feel like a text-only placeholder when the feature menu sends someone here.</p>"
