    {
      "slug": "comparison",
      "title": "Debt comparison",
      "category": "Debt and payments",
      "description": "Compare avalanche and snowball payoff plans using the same monthly budget.",
      "fields": [
        {
          "name": "extra",
          "label": "Extra monthly payment across all debts",
          "type": "number",
          "value": 100,
          "min": 0,
          "max": 100000000,
          "step": 0.01
        }
      ],
      "rows": {
        "label": "Debt",
        "fields": [
          {
            "name": "balance",
            "label": "Balance",
            "type": "number",
            "value": 2400,
            "min": 0,
            "max": 100000000,
            "step": 0.01
          },
          {
            "name": "apr",
            "label": "APR (%)",
            "type": "number",
            "value": 20,
            "min": 0,
            "max": 100,
            "step": 0.01
          },
          {
            "name": "minimum",
            "label": "Monthly minimum payment",
            "type": "number",
            "value": 80,
            "min": 0,
            "max": 100000000,
            "step": 0.01
          }
        ]
      },
      "method": "The monthly budget is all entered minimum payments plus extra. After minimums, remaining money goes to the highest APR (avalanche) or smallest balance (snowball). Payments freed by a payoff roll to the next debt, including within the same month. Assumes fixed APRs/minimums, monthly interest, no fees or new borrowing; maximum 600 months.",
      "source": [
        "CFPB debt repayment strategies",
        "https://www.consumerfinance.gov/archive/blog/how-reduce-your-debt/"
      ]
    },
