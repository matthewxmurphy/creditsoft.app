{
  "tools": [
    {
      "slug": "budget",
      "title": "Budget coaching",
      "category": "Everyday money",
      "description": "See what remains after essential bills, debt payments and your savings target.",
      "fields": [
        {
          "name": "income",
          "label": "Monthly take-home income",
          "type": "number",
          "value": 4200,
          "min": 0,
          "max": 100000000,
          "step": 0.01
        },
        {
          "name": "essential",
          "label": "Essential bills",
          "type": "number",
          "value": 2100,
          "min": 0,
          "max": 100000000,
          "step": 0.01
        },
        {
          "name": "debt",
          "label": "Debt payments",
          "type": "number",
          "value": 550,
          "min": 0,
          "max": 100000000,
          "step": 0.01
        },
        {
          "name": "savings",
          "label": "Savings target",
          "type": "number",
          "value": 300,
          "min": 0,
          "max": 100000000,
          "step": 0.01
        }
      ],
      "method": "Monthly cushion equals take-home income minus essential bills, debt payments and savings. Include each expense once; a positive cushion is unallocated cash, not a promise of affordability.",
      "source": [
        "CFPB money planning toolkit",
        "https://www.consumerfinance.gov/consumer-tools/educator-tools/your-money-your-goals/toolkit/"
      ]
    },
    {
      "slug": "payoff",
      "title": "Payoff planner",
      "category": "Debt and payments",
      "description": "Estimate the time and interest needed to pay one balance, with or without extra payments.",
      "fields": [
        {
          "name": "balance",
          "label": "Current balance",
          "type": "number",
          "value": 4800,
          "min": 0,
          "max": 100000000,
          "step": 0.01
        },
        {
          "name": "apr",
          "label": "APR (%)",
          "type": "number",
          "value": 24.99,
          "min": 0,
          "max": 100,
          "step": 0.01
        },
        {
          "name": "payment",
          "label": "Monthly payment",
          "type": "number",
          "value": 180,
          "min": 0,
          "max": 100000000,
          "step": 0.01
        },
        {
          "name": "extra",
          "label": "Extra monthly payment",
          "type": "number",
          "value": 40,
          "min": 0,
          "max": 100000000,
          "step": 0.01
        }
      ],
      "method": "Assumes fixed APR, monthly interest at APR / 12, payments at month end, no fees and no new purchases. Interest is rounded to cents each month. Actual statements may use daily interest. Estimates stop at 600 months and never label an unpaid balance as paid off.",
      "source": [
        "CFPB debt repayment strategies",
        "https://www.consumerfinance.gov/archive/blog/how-reduce-your-debt/"
      ]
    },
    {
      "slug": "utilization",
      "title": "Utilization targets",
      "category": "Credit planning",
      "description": "Calculate your revolving balance-to-limit ratio and the paydown needed for a chosen target.",
      "fields": [
        {
          "name": "limit",
          "label": "Total revolving credit limit",
          "type": "number",
          "value": 5000,
          "min": 0,
          "max": 100000000,
          "step": 0.01
        },
        {
          "name": "balance",
          "label": "Total revolving balance",
          "type": "number",
          "value": 2100,
          "min": 0,
          "max": 100000000,
          "step": 0.01
        },
        {
          "name": "target",
          "label": "Target utilization (%)",
          "type": "number",
          "value": 30,
          "min": 0,
          "max": 100,
          "step": 0.01
        }
      ],
      "method": "Utilization is revolving balance divided by revolving credit limit. Targets are planning examples, not score cutoffs or approval requirements. A lower ratio does not imply a specific score change.",
      "source": [
        "CFPB guide to credit scores",
        "https://www.consumerfinance.gov/consumer-tools/credit-reports-and-scores/understand-your-credit-score/"
      ]
    },
