    {
      "slug": "simulator",
      "title": "Score scenario planner",
      "originalTitle": "Score simulator",
      "category": "Credit planning",
      "description": "See utilization before and after a planned paydown. Actual credit-score changes vary.",
      "fields": [
        {
          "name": "limit",
          "label": "Total revolving credit limit",
          "type": "number",
          "value": 10000,
          "min": 0,
          "max": 100000000,
          "step": 0.01
        },
        {
          "name": "balance",
          "label": "Current revolving balance",
          "type": "number",
          "value": 4000,
          "min": 0,
          "max": 100000000,
          "step": 0.01
        },
        {
          "name": "paydown",
          "label": "Proposed balance paydown",
          "type": "number",
          "value": 1500,
          "min": 0,
          "max": 100000000,
          "step": 0.01
        }
      ],
      "method": "Compares balance-to-limit ratios before and after the paydown, keeping the limit unchanged. Actual scores depend on the full credit file and scoring model. No point estimate or score increase is claimed.",
      "source": [
        "How credit scores are calculated",
        "https://www.consumerfinance.gov/ask-cfpb/what-is-a-credit-score-en-315/"
      ]
    },
