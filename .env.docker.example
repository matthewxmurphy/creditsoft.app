APP_NAME=CreditSoft
APP_ENV=production
# Generate a stable production key with:
# php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8001
CREDITSOFT_DOCKER_PORT=8001
CREDITSOFT_ROUTER_PORT=8877
OFFICE_PG_PUBLIC_PORT=5432

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/database/database.sqlite
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=creditsoft
DB_PASSWORD=
DB_SSLMODE=prefer
OFFICE_PG_SUPERUSER=creditsoft_root
OFFICE_PG_SUPERPASSWORD=replace_me_with_a_strong_root_password_without_special_characters
CREDITSOFT_PG_DATABASE=creditsoft
CREDITSOFT_PG_USER=creditsoft
CREDITSOFT_PG_PASSWORD=replace_me_with_a_strong_password_without_special_characters

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
MAIL_MAILER=log

BACKUP_DESTINATION_DISKS=local
BACKUP_ARCHIVE_PASSWORD=
BACKUP_NOTIFY_EMAIL=ops@creditsoft.local

CREDITSOFT_PORTAL_URL=https://www.creditsoft.app
CREDITSOFT_TAILSCALE_REQUIRED=true
CREDITSOFT_TAILSCALE_HOSTNAME=creditsoft-intranet
CREDITSOFT_TAILSCALE_TAILNET=
CREDITSOFT_TAILSCALE_API_KEY=
CREDITSOFT_TAILSCALE_API_KEY_EXPIRES_AT=
CREDITSOFT_NGROK_ENABLED=false
CREDITSOFT_NGROK_API_ONLY=true
CREDITSOFT_NGROK_AUTHTOKEN=
CREDITSOFT_NGROK_API_KEY=
CREDITSOFT_API_ENABLED=true
CREDITSOFT_API_TOKEN=
CREDITSOFT_API_PUBLIC_BASE_URL=
CREDITSOFT_INSTALLER_ENABLED=true
CREDITSOFT_LICENSE_MODE=auto
CREDITSOFT_LICENSE_API_URL=https://api.creditsoft.app/license/validate
CREDITSOFT_LICENSE_PORTAL_URL=https://www.creditsoft.app/license/validate.json
CREDITSOFT_LICENSE_GRACE_DAYS=7
CREDITSOFT_UPDATE_FEED_URL=https://www.creditsoft.app/updates.creditsoft.app/api/update-feed.php
CREDITSOFT_AI_DEFAULT_PROVIDER=openrouter_creditsoft
CREDITSOFT_DISPUTEFOX_INBOX_HOST_PATH=./storage/app/private/companion-inbox/disputefox-host
CREDITSOFT_DISPUTEFOX_DOCUMENT_INBOX_PATHS=/var/www/html/storage/app/private/companion-inbox/disputefox
CREDITSOFT_DISPUTEFOX_DOCUMENT_INBOX_PRUNE_TINY_PREVIEWS=true

CREDITSOFT_CRM_ENABLED=false
CREDITSOFT_CRM_BASE_URL=
CREDITSOFT_CRM_API_KEY=

CRM_TAG=latest
CRM_IMAGE=creditsoft/crm-sidecar:local
CRM_BASE_IMAGE=update.creditsoft.app/creditsoft/crm-sidecar:latest
CRM_PORT=3000
CRM_SERVER_URL=http://localhost:3000
CRM_APP_SECRET=replace_me_with_a_random_string
CRM_PG_HOST=office-db
CRM_PG_PORT=5432
CRM_PG_DATABASE=crm
CRM_PG_USER=crm
CRM_PG_PASSWORD=replace_me_with_a_strong_crm_password_without_special_characters
CRM_STORAGE_TYPE=local

OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL=arcee-ai/trinity-large-thinking

VITE_APP_NAME="${APP_NAME}"
